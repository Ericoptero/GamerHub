# Copie para .env e preencha. Tudo é opcional: sem chaves, o app funciona
# normalmente e as integrações aparecem como "não configuradas".

# IGDB (fonte principal de metadados). Crie um app em https://dev.twitch.tv/console/apps
# (OAuth Redirect URL: http://localhost) e copie Client ID e Client Secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# RAWG (fallback de metadados + nota do Metacritic). Chave grátis em https://rawg.io/apidocs
RAWG_API_KEY=

# Metacritic: hoje o backend JSON público não exige chave. Se passar a exigir,
# coloque aqui (vai como query param `apiKey`).
METACRITIC_API_KEY=

# Steam Web API, para conectar contas Steam pela URL do perfil. Chave grátis em
# https://steamcommunity.com/dev/apikey (Epic e GOG não precisam de chave: o login é pela tela).
STEAM_API_KEY=

# Hora local (fuso TZ abaixo) a partir da qual as contas de loja são checadas, uma vez por dia.
LIBRARY_SYNC_HOUR=5

# Baixar screenshots para o disco local (capa e fundo são sempre baixados).
CACHE_SCREENSHOTS=true

# Fuso horário usado nas datas de comentários e backups.
TZ=America/Sao_Paulo

# Login opcional. Desligado: um usuário só, sem tela de login (como sempre foi).
# Ligado: a primeira conta criada vira admin e fica com a biblioteca atual; cada usuário
# tem a própria biblioteca. AUTH_ALLOW_SIGNUP=false fecha o cadastro (admin cria as contas).
AUTH_ENABLED=false
AUTH_ALLOW_SIGNUP=true
AUTH_SESSION_DAYS=30
# Ligue se o GamerHub for servido por HTTPS (cookie só trafega cifrado).
AUTH_COOKIE_SECURE=false

# Porta e IP do host onde o app fica acessível (padrão: 8080 em todas as interfaces).
GAMERHUB_PORT=8080
GAMERHUB_BIND_IP=0.0.0.0
