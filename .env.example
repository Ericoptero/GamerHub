# Copie para .env e preencha. Tudo é opcional.

# As chaves de API (IGDB, RAWG, Steam, Metacritic) são cadastradas na tela Configurações, com o
# passo a passo de onde conseguir cada uma. As linhas abaixo só servem para quem já tinha as chaves
# no .env: no início, cada chave daqui que o banco ainda não tem é copiada para ele uma vez.
# Depois disso, edite pela tela e pode apagar estas linhas.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
METACRITIC_API_KEY=
STEAM_API_KEY=

# Hora local (fuso TZ abaixo) a partir da qual as contas de loja são checadas, uma vez por dia.
LIBRARY_SYNC_HOUR=5

# Baixar screenshots para o disco local (capa e fundo são sempre baixados).
CACHE_SCREENSHOTS=true

# Fuso horário usado nas datas de comentários e backups.
TZ=America/Sao_Paulo

# Login opcional. Desligado: um usuário só, sem tela de login (como sempre foi).
# Ligado: a primeira conta criada vira admin e fica com a biblioteca atual; cada usuário
# tem a própria biblioteca. AUTH_ALLOW_SIGNUP=false fecha o cadastro (admin cria as contas).
AUTH_ENABLED=false
AUTH_ALLOW_SIGNUP=true
AUTH_SESSION_DAYS=30
# Ligue se o GamerHub for servido por HTTPS (cookie só trafega cifrado).
AUTH_COOKIE_SECURE=false

# Porta e IP do host onde o app fica acessível (padrão: 8080 em todas as interfaces).
GAMERHUB_PORT=8080
GAMERHUB_BIND_IP=0.0.0.0
